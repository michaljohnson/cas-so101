<?xml version="1.0" ?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo scenes and models for the SO-101 in the ZHAW CAS Physical AI &amp; Robotics
    course (Module C): table, pen and the pick scene launch.
  </description>
  <maintainer email="michalmederlet@gmail.com">Michal Johnson</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>so_arm101_moveit_config</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
