<?xml version="1.0" encoding="UTF-8" ?>
<!-- Semantic description of the SO-ARM101 for MoveIt.
     Adapted from so_arm100.srdf: same joint names; the planning tip is the
     SO-101's gripper_frame_link (between the fingers), and the named poses
     are kept inside the SO-101 joint limits. -->
<robot name="so_arm101">
  <group name="manipulator">
    <chain base_link="base_link" tip_link="gripper_frame_link" />
  </group>
  <group name="gripper">
    <link name="jaw_link" />
    <joint name="gripper_joint" />
  </group>

  <!-- gripper_joint limits on the SO-101: 0.0 .. 1.70 -->
  <group_state name="open" group="gripper">
    <joint name="gripper_joint" value="1.5" />
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_joint" value="0.0" />
  </group_state>

  <group_state name="zero" group="manipulator">
    <joint name="shoulder_pan_joint" value="0" />
    <joint name="shoulder_lift_joint" value="0" />
    <joint name="elbow_flex_joint" value="0" />
    <joint name="wrist_flex_joint" value="0" />
    <joint name="wrist_roll_joint" value="0" />
  </group_state>
  <group_state name="extended" group="manipulator">
    <joint name="shoulder_pan_joint" value="0" />
    <joint name="shoulder_lift_joint" value="1.57" />
    <joint name="elbow_flex_joint" value="-1.57" />
    <joint name="wrist_flex_joint" value="-1.57" />
    <joint name="wrist_roll_joint" value="1.57" />
  </group_state>
  <!-- SO-100 values clamped to the SO-101 limits (lift >= -1.745, elbow <= 1.54) -->
  <group_state name="rest" group="manipulator">
    <joint name="shoulder_pan_joint" value="0" />
    <joint name="shoulder_lift_joint" value="-1.7" />
    <joint name="elbow_flex_joint" value="1.5" />
    <joint name="wrist_flex_joint" value="-0.35" />
    <joint name="wrist_roll_joint" value="1.57" />
  </group_state>

  <end_effector name="gripper" parent_link="gripper_frame_link" group="gripper" parent_group="manipulator" />

  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="upper_arm_link" link2="lower_arm_link" reason="Adjacent" />
  <disable_collisions link1="lower_arm_link" link2="wrist_link" reason="Adjacent" />
  <disable_collisions link1="wrist_link" link2="gripper_link" reason="Adjacent" />
  <disable_collisions link1="gripper_link" link2="jaw_link" reason="Adjacent" />
</robot>
